# Copy to .env and adjust. Only GIT_REPO_URL is required.

# --- Vault repository ---------------------------------------------------------
# SSH (with a read-only deploy key), HTTPS (token in the URL) or a local path
GIT_REPO_URL=ssh://git@git.example.com/acme/knowledge-base.git
GIT_BRANCH=main
# seconds between pulls
SYNC_INTERVAL=300
# private deploy key (multi-line, or one line with \n); keep it secret
GIT_SSH_PRIVATE_KEY=
# output of `ssh-keyscan [-p PORT] git.example.com`; empty = trust on first use
GIT_SSH_KNOWN_HOSTS=
# folders (relative to the vault) to skip, comma-separated, e.g. "Templates,Archive"
INDEX_EXCLUDE=

# --- Access control (see docs/access-control.md) ------------------------------
# Single shared token with full access. Leave empty when you use accounts only.
# With neither a token nor an access policy the server is OPEN.
MCP_AUTH_TOKEN=
# Optional: keep access.yaml in a separate Git repository (same deploy key)
ACCESS_GIT_URL=
ACCESS_GIT_BRANCH=main
ACCESS_GIT_PATH=access.yaml

# --- Search -------------------------------------------------------------------
# full-text stemming/stop words: English, German, French, Spanish, Italian, ...
# (changing it triggers a full rebuild from the embedding cache)
FTS_LANGUAGE=English
EMBED_MODEL=BAAI/bge-m3
# mmarco is fast and good, but trained on MS MARCO (non-commercial research licence).
# License-clean alternative: BAAI/bge-reranker-v2-m3 (Apache-2.0, ~4x slower)
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Operations ---------------------------------------------------------------
# status line in the log every n seconds while a long task runs (0 = off)
STATUS_INTERVAL=60
# save computed embeddings every n seconds during an update
CHECKPOINT_INTERVAL=60
LOG_LEVEL=INFO
